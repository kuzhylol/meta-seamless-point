[Unit]
Description=AUX Connect controller
Wants=usbsound-controller.service
Requires=network-online.target
After=network-online.target usbsound-controller.service

[Service]
ExecStart=/usr/bin/usb-interface.sh start
ExecStop=/usr/bin/usb-interface.sh stop
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
