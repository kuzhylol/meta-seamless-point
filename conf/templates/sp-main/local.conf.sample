MACHINE = "raspberrypi4-64"
DISTRO ?= "poky"
PACKAGE_CLASSES ?= "package_deb"
EXTRA_IMAGE_FEATURES ?= "debug-tweaks package-management serial-autologin-root ssh-server-openssh"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"
CONF_VERSION = "2"

RM_OLD_IMAGE = "1"
INHERIT += "rm_work"

LICENSE_FLAGS_ACCEPTED = "commercial synaptics-killswitch"

DISTRO_FEATURES = "alsa bluetooth ipv4 systemd wifi xattr"
INIT_MANAGER = "systemd"

DISTRO_FEATURES += "x11 wayland opengl"

ENABLE_KGDB = "1"
DISABLE_RPI_BOOT_LOGO = "1"
ENABLE_UART = "1"
IMAGE_FSTYPES = "wic.bz2 wic.bmap"
RPI_USE_U_BOOT = "1"
SERIAL_CONSOLES ?= "115200;ttyAMA0"

#CMDLINE_ROOT_PARTITION = "/dev/sda2"
#CONFIG_PM_STD_PARTITION = "/dev/sda2"
CMDLINE_ROOT_PARTITION = "/dev/mmcblk0p2"
CONFIG_PM_STD_PARTITION = "/dev/mmcblk0p2"
#BOOT_MEDIA = "usb"

RPI_EXTRA_CONFIG = ' \n \
dtoverlay=disable-bt \n \
dtoverlay=gc9a01.dtbo \n \
\'

# Remote debugging needs gdbserver on the target device
IMAGE_INSTALL:append = " gdbserver"
IMAGE_INSTALL:append = " seamless-point"

RPI_KERNEL_DEVICETREE_OVERLAYS:append = " overlays/gc9a01.dtbo"

MACHINE_ESSENTIAL_EXTRA_RRECOMMENDS += "kernel-module-brcmfmac"
MACHINE_ESSENTIAL_EXTRA_RRECOMMENDS += "kernel-module-brcmfmac-wcc"
