From 9e799565bdef801367a8ec878aa179f012b7e873 Mon Sep 17 00:00:00 2001
From: Oleh Kuzhylnyi <kuzhylol@gmail.com>
Date: Thu, 13 Feb 2025 14:46:39 +0100
Subject: [PATCH] rename WiFi Connect SSID to SeamlessPoint

---
 src/config.rs        | 2 +-
 ui/public/index.html | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index 3afad7a..1868b14 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -8,7 +8,7 @@ use std::ffi::OsStr;
 
 const DEFAULT_GATEWAY: &str = "192.168.42.1";
 const DEFAULT_DHCP_RANGE: &str = "192.168.42.2,192.168.42.254";
-const DEFAULT_SSID: &str = "WiFi Connect";
+const DEFAULT_SSID: &str = "SeamlessPoint";
 const DEFAULT_ACTIVITY_TIMEOUT: &str = "0";
 const DEFAULT_UI_DIRECTORY: &str = "ui";
 const DEFAULT_LISTENING_PORT: &str = "80";
diff --git a/ui/public/index.html b/ui/public/index.html
index 440a650..e94fdc2 100644
--- a/ui/public/index.html
+++ b/ui/public/index.html
@@ -15,7 +15,7 @@
       work correctly both with client-side routing and a non-root public URL.
       Learn how to configure a non-root public URL by running `npm run build`.
     -->
-    <title>WiFi Connect</title>
+    <title>SeamlessPoint Connect</title>
   </head>
   <body>
     <noscript>You need to enable JavaScript to run this app.</noscript>
